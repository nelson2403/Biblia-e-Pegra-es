# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# Service role — SÓ no servidor. Nunca prefixe com NEXT_PUBLIC_.
# Supabase → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ── IA (Groq) ───────────────────────────────────────────────
# Usada no conselheiro, geração de pregações, estudo do dia,
# transcrição de áudio (Whisper) e organização de anotações.
GROQ_API_KEY=sua-chave-groq-aqui

# ── Notificações push (Web Push / VAPID) ────────────────────
# Gere o par com: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=chave-publica-vapid
VAPID_PRIVATE_KEY=chave-privada-vapid
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# ── Cron ────────────────────────────────────────────────────
# Protege /api/cron/diario quando chamado fora da Vercel.
CRON_SECRET=uma-frase-secreta-longa-e-aleatoria

# ── Site ────────────────────────────────────────────────────
# URL pública final (usada nos metadados e nos links de compartilhamento).
NEXT_PUBLIC_SITE_URL=https://seu-app.vercel.app
